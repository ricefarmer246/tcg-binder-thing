# Copy this file to .env and fill in the values from your Appwrite project.
# If you run `npm run setup:appwrite`, most of these are printed out for you at the end.

VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=
VITE_APPWRITE_DATABASE_ID=
VITE_APPWRITE_BINDERS_COLLECTION_ID=
VITE_APPWRITE_CARDS_COLLECTION_ID=
VITE_APPWRITE_BUCKET_ID=

# Only needed to run `npm run setup:appwrite` (server-side, never shipped to the browser).
# Create this key in Appwrite: Project Settings > API Keys, with scopes:
# databases.write, collections.write, attributes.write, indexes.write, documents.write, buckets.write, files.write
APPWRITE_API_KEY=
